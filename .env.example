# =============================================================================
# COWRIE — Environment Variables Template
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# =============================================================================

# --- Database (Neon Postgres) ---
DATABASE_URL=postgresql://user:password@your-neon-host/dbname

# --- Authentication (Neon Auth = managed Better Auth) ---
# Configure email delivery + Google OAuth in the Neon Console.
NEON_AUTH_BASE_URL=https://your-neon-auth-url
NEON_AUTH_COOKIE_SECRET=generate-a-32-character-or-longer-secret-here
# Enables the "Continue with Google" buttons. Must be "true" after enabling
# Google OAuth in the Neon Console, otherwise the button is hidden.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# --- Payments (MTN Mobile Money — Collection API) ---
# Credentials are used server-side only — they never reach the browser.
# Get them from the MTN MoMo developer portal (sandbox: sandbox.momodeveloper.mtn.com).
MTN_MODE=sandbox
# Optional override; defaults to sandbox/production base URLs automatically.
MTN_API_BASE_URL=https://sandbox.momodeveloper.mtn.com
# "sandbox" or your market code in production, e.g. "mtnghana".
MTN_TARGET_ENVIRONMENT=sandbox
MTN_COLLECTION_PRIMARY_KEY=your_collection_primary_key
MTN_API_USER=your_api_user
MTN_API_KEY=your_api_key
# Org/admin phone number that funds settle to (country code form, e.g. 2335xxxxxxxx).
MTN_PAYEE_MSISDN=2332xxxxxxxx
# Always GHS. NOTE: the MTN sandbox processes in EUR internally; production honours GHS.
MTN_CURRENCY=GHS
# Collection callback URL for payment/pre-approval events:
#   https://<your-domain>/api/webhooks/mtn
MTN_CALLBACK_URL=https://<your-domain>/api/webhooks/mtn

# --- Recurring debits (cron job) ---
# Guards the /api/cron/subscriptions endpoint. Set any long random string.
CRON_SECRET=generate-a-long-random-string

# --- App ---
# Used for absolute URLs in emails, share links (QR codes), and Paystack
# return callback URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000